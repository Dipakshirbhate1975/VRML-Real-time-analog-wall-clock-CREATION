   visibilityLimit 0
   speed 1
   headlight TRUE
   type ["WALK"
   "ANY"]
  }
  DEF dad_DIAL Transform {
   translation 0 .01573 .80701
   rotation -1 0 0 1.571
   children [
    DEF DIAL Shape {
     appearance Appearance {
      material DEF White Material {
       ambientIntensity 0.200
       shininess 0.200
       diffuseColor 1 1 1
      }
     }
     geometry DEF GeoCylinder1 Cylinder {
      height 0.200
      radius 3.000
     }
    }
   ]
  }
  DEF Transform3 Transform {
   children [
