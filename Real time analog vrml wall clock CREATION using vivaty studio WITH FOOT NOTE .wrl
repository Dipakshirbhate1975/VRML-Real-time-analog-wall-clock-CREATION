  DEF CM TimeSensor {
   cycleInterval 1.000
   loop TRUE
   startTime -1.000
  }
  DEF REFRESH TimeSensor {
   cycleInterval 0.100
   loop TRUE
   startTime -1.000
  }
  DEF more_time Script {
    eventOut SFRotation second_changed
    eventIn SFTime set_second
    eventOut SFRotation minute_changed
    eventOut SFRotation hour_changed
   url [ "javascript:
function initialize(){
}


function set_second () {
 var today = new Date();
 var seconds = today.getSeconds();
 var minutes =  -(Math.PI/30)*today.getMinutes();
 var hours = -(Math.PI/6)*today.getHours();
 second_changed[3] = -(Math.PI/30)*seconds ;
 minute_changed[3]= minutes -(Math.PI/30)*seconds/60; 
 hour_changed[3]= hours -(Math.PI/6)*today.getMinutes()/60;
}" ]
  }
  DEF cm_enabled Script {
    eventOut SFBool start
    eventIn SFTime set_milli
   url [ "javascript: // ### X3D Browser.print() not supported by all VRML97 viewers, instead simply using print()

function set_milli () {
 var today = new Date();
 var milli = today.getTime();
 var milli_changed= (milli/1000) - Math.floor(milli/1000);
 printing (milli_changed);
 if (milli_changed>0 && milli_changed<0.1) {start=true;}
}" ]
  }
 ]
}
DEF vizx_init TimeSensor {
 cycleInterval 0.100
 loop TRUE
}
ROUTE vizx_init.cycleTime TO CM.startTime
ROUTE vizx_init.cycleTime TO REFRESH.startTime
ROUTE vizx_init.cycleTime TO vizx_init.stopTime
ROUTE REFRESH.cycleTime TO cm_enabled.set_milli
ROUTE REFRESH.time TO more_time.set_second
ROUTE more_time.second_changed TO Transform1.set_rotation
ROUTE cm_enabled.start TO CM.set_enabled
ROUTE more_time.minute_changed TO Transform2.set_rotation
ROUTE more_time.hour_changed TO Transform3.set_rotation

