  DEF Transform1 Transform {
   children [
    DEF dad_SECONDHAND Transform {
     rotation 1 0 0 1.571
     scale .5 1 1.2
     children [
      DEF SECONDHAND Shape {
       appearance Appearance {
        material DEF Yellow Material {
         ambientIntensity 0.200
